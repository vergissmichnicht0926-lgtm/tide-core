# 复制成 gateway/.env 后按需修改；用 node --env-file=gateway/.env gateway/server.mjs 启动
# 注意：这个文件里不要提交真实密钥（.env 已在 .gitignore 里）

# —— 必需 ——
# JWT 签名密钥，随机 32 字节的 base64；换掉等于让所有已发 token 失效
TIDE_JWT_SECRET=
# Agent 调用密钥，AI 侧（MCP）用 x-agent-secret 调网关时校验
TIDE_AGENT_SECRET=
# DSH 宿主地址：网关通过 ACP 把消息交给它处理
TIDE_DSH_BASE_URL=http://127.0.0.1:3081
# DSH 的家目录（网关会读写它的会话与附件）
DSH_HOME=

# —— 可选 ——
TIDE_GATEWAY_HOST=0.0.0.0
TIDE_GATEWAY_PORT=7800
TIDE_DB_PATH=./data/gateway.db
# 管理员 user id，多个用逗号分隔；管理台和 /admin/* 只认这些人
TIDE_OWNER_IDS=
# 对外地址，用于邀请链接与落地页，形如 https://example.com/tide
TIDE_PUBLIC_BASE_URL=
# 1 = 要求设备密钥（见 README「设备信任」）
TIDE_DEVICE_TRUST_REQUIRED=1
# 老会话免密钥的过渡截止时间（UTC ISO8601）；留空 = 不设截止
TIDE_DEVICE_TRUST_ENROLL_DEADLINE=
# 单个上传上限（字节）
TIDE_UPLOAD_MAX_BYTES=20971520
# 单会话占用上限（字节）
TIDE_CONVERSATION_MAX_BYTES=
# 工作区根目录：附件按 conversations/<id>/attachments 落盘
TIDE_WORKSPACE_ROOT=./data
